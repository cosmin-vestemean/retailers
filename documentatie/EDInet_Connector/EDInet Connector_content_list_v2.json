                        "item_content": [
                            {
                                "type": "text",
                                "content": "1. Please download EC from here: http://www.infinite.pl/pub/soft/edinetconnector/"
                            }
                        ]
                    },
                    {
                        "item_type": "text",
                        "item_content": [
                            {
                                "type": "text",
                                "content": "File: EdinetConnector-1.6.exe"
                            }
                        ]
                    },
                    {
                        "item_type": "text",
                        "item_content": [
                            {
                                "type": "text",
                                "content": "You need the latest java library."
                            }
                        ]
                    },
                    {
                        "item_type": "text",
                        "item_content": [
                            {
                                "type": "text",
                                "content": "2. Start installation process with EdinetConnector-1.6.exe"
                            }
                        ]
                    },
                    {
                        "item_type": "text",
                        "item_content": [
                            {
                                "type": "text",
                                "content": "3. Chose language and click Next"
